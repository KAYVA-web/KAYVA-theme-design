{{ 'kayva.css' | asset_url | stylesheet_tag }}
<style>
.kv-tstep-{{ section.id }} { background: {{ section.settings.bg }}; padding: 80px 0; border-top: 1px solid var(--kayva-line, #E8E0D2); }
.kv-tstep-{{ section.id }} .kv-tstep__eyebrow {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-amber, #B8753A);
  display: block;
  margin-bottom: 10px;
}
.kv-tstep-{{ section.id }} h2 {
  font-family: var(--kayva-font);
  font-weight: 600;
  font-size: 28px;
  color: var(--kayva-dark-brown, #3D2A15);
  line-height: 1.2;
  margin: 0 0 40px;
}
.kv-tstep-{{ section.id }} .kv-tstep__grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, 1fr);
  border-top: 1px solid var(--kayva-line, #E8E0D2);
}
.kv-tstep-{{ section.id }} .kv-tstep__link {
  font-family: var(--kayva-font);
  font-size: 13px;
  color: var(--kayva-amber, #B8753A);
  text-decoration: none;
  border-bottom: 1px solid rgba(184, 117, 58, 0.4);
  align-self: flex-start;
}
.kv-tstep-{{ section.id }} .kv-tstep__item {
  padding: 28px;
  border-right: 1px solid var(--kayva-line, #E8E0D2);
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.kv-tstep-{{ section.id }} .kv-tstep__item:first-child { padding-left: 0; }
.kv-tstep-{{ section.id }} .kv-tstep__item:last-child { padding-right: 0; border-right: none; }
.kv-tstep-{{ section.id }} .kv-tstep__label {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  color: var(--kayva-amber, #B8753A);
  margin: 0;
}
.kv-tstep-{{ section.id }} .kv-tstep__title {
  font-family: var(--kayva-font);
  font-weight: 600;
  font-size: 15px;
  color: var(--kayva-dark-brown, #3D2A15);
  margin: 0;
}
.kv-tstep-{{ section.id }} .kv-tstep__text {
  font-family: var(--kayva-font);
  font-size: 13px;
  color: var(--kayva-ink, #1F1B16);
  line-height: 1.7;
  opacity: 0.8;
  margin: 0;
}
@media (max-width: 900px) {
  .kv-tstep-{{ section.id }} { padding: 56px 0; }
  .kv-tstep-{{ section.id }} .kv-tstep__grid { grid-template-columns: 1fr; }
  .kv-tstep-{{ section.id }} .kv-tstep__item { border-right: none; border-bottom: 1px solid var(--kayva-line, #E8E0D2); padding: 22px 0; }
  .kv-tstep-{{ section.id }} .kv-tstep__item:last-child { border-bottom: none; }
}
</style>

<section class="kv-tstep-{{ section.id }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}" style="scroll-margin-top: 16px;"{% endif %}>
  <div class="kayva-page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="kv-tstep__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    <div class="kv-tstep__grid">
      {%- for block in section.blocks -%}
        <div class="kv-tstep__item" {{ block.shopify_attributes }}>
          {%- assign step_num = forloop.index | prepend: '0' | slice: -2, 2 -%}
          {%- liquid
            assign prefix = section.settings.label_prefix | default: 'Step'
            if prefix == 'none'
              assign step_label = step_num
            else
              assign step_label = prefix | append: ' ' | append: step_num
            endif
          -%}
          <p class="kv-tstep__label">{{ step_label }}</p>
          <p class="kv-tstep__title">{{ block.settings.title }}</p>
          <p class="kv-tstep__text">{{ block.settings.text }}</p>
          {%- if block.settings.link_label != blank -%}
            <a href="{{ block.settings.link_url | default: '#' }}" class="kv-tstep__link">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KAYVA Trade Steps",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How It Works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Approved in two working days." },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "text", "id": "label_prefix", "label": "Number prefix", "info": "e.g. Step. Enter \"none\" for the number only.", "default": "Step" },
    { "type": "text", "id": "anchor", "label": "Anchor ID (optional)", "info": "e.g. buying — lets links jump to this section with #buying" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Apply" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Company name, UEN, and the kind of work you do. Two minutes." },
        { "type": "text", "id": "link_label", "label": "Link label (optional)" },
        { "type": "url", "id": "link_url", "label": "Link URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "KAYVA Trade Steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Apply", "text": "Company name, UEN, and the kind of work you do. Two minutes." } },
        { "type": "step", "settings": { "title": "We verify", "text": "We check the UEN against ACRA and confirm your tier by email." } },
        { "type": "step", "settings": { "title": "Sample", "text": "Sample pack ships the same day your account is approved." } },
        { "type": "step", "settings": { "title": "Order", "text": "Trade prices show on the site when you're signed in. Quotes on WhatsApp." } }
      ]
    }
  ]
}
{% endschema %}
