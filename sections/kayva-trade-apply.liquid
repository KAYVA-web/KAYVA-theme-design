{{ 'kayva.css' | asset_url | stylesheet_tag }}
<style>
.kv-tapp-{{ section.id }} { background: {{ section.settings.bg }}; padding: 80px 0; scroll-margin-top: 16px; }
.kv-tapp-{{ section.id }} .kv-tapp__wrap {
  display: grid;
  grid-template-columns: 1fr 1.15fr;
  gap: 80px;
  align-items: start;
}
.kv-tapp-{{ section.id }} .kv-tapp__copy { display: flex; flex-direction: column; gap: 20px; }
.kv-tapp-{{ section.id }} .kv-tapp__eyebrow {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-amber, #B8753A);
}
.kv-tapp-{{ section.id }} h2 {
  font-family: var(--kayva-font);
  font-weight: 600;
  font-size: 28px;
  color: var(--kayva-dark-brown, #3D2A15);
  line-height: 1.2;
  margin: 0;
}
.kv-tapp-{{ section.id }} .kv-tapp__text {
  font-family: var(--kayva-font);
  font-size: 15px;
  color: var(--kayva-ink, #1F1B16);
  line-height: 1.75;
  margin: 0;
}
.kv-tapp-{{ section.id }} .kv-tapp__contact {
  border-top: 1px solid var(--kayva-line, #E8E0D2);
  padding-top: 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.kv-tapp-{{ section.id }} .kv-tapp__contact-label {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-soft-brown, #8A5524);
  margin: 0;
}
.kv-tapp-{{ section.id }} .kv-tapp__contact a {
  font-family: var(--kayva-font);
  font-size: 15px;
  font-weight: 500;
  color: var(--kayva-dark-brown, #3D2A15);
  text-decoration: none;
}
.kv-tapp-{{ section.id }} .kv-tapp__contact a:hover { color: var(--kayva-amber, #B8753A); }
.kv-tapp-{{ section.id }} .kv-tapp__hours {
  font-family: var(--kayva-font);
  font-size: 13px;
  color: var(--kayva-soft-brown, #8A5524);
  line-height: 1.6;
  margin: 0;
}
.kv-tapp-{{ section.id }} .kv-tapp__form-box { border: 1px solid var(--kayva-line, #E8E0D2); padding: 36px; }
.kv-tapp-{{ section.id }} .kv-tapp__form { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.kv-tapp-{{ section.id }} .kv-tapp__field { display: flex; flex-direction: column; gap: 7px; }
.kv-tapp-{{ section.id }} .kv-tapp__field--full { grid-column: span 2; }
.kv-tapp-{{ section.id }} .kv-tapp__field label {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--kayva-soft-brown, #8A5524);
}
.kv-tapp-{{ section.id }} .kv-tapp__field input,
.kv-tapp-{{ section.id }} .kv-tapp__field select,
.kv-tapp-{{ section.id }} .kv-tapp__field textarea {
  font-family: var(--kayva-font);
  padding: 12px 14px;
  border: 1.5px solid var(--kayva-line, #E8E0D2);
  font-size: 14px;
  color: var(--kayva-dark-brown, #3D2A15);
  background: var(--kayva-white, #FFFFFF);
  outline: none;
  border-radius: 0;
  width: 100%;
}
.kv-tapp-{{ section.id }} .kv-tapp__field textarea { resize: vertical; line-height: 1.6; }
.kv-tapp-{{ section.id }} .kv-tapp__field input:focus,
.kv-tapp-{{ section.id }} .kv-tapp__field select:focus,
.kv-tapp-{{ section.id }} .kv-tapp__field textarea:focus { border-color: var(--kayva-dark-brown, #3D2A15); }
.kv-tapp-{{ section.id }} .kv-tapp__footer {
  grid-column: span 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  border-top: 1px solid var(--kayva-line, #E8E0D2);
  padding-top: 22px;
  flex-wrap: wrap;
}
.kv-tapp-{{ section.id }} .kv-tapp__privacy {
  font-family: var(--kayva-font);
  font-size: 12px;
  color: var(--kayva-soft-brown, #8A5524);
  line-height: 1.6;
  margin: 0;
  max-width: 300px;
}
.kv-tapp-{{ section.id }} .kv-tapp__submit {
  font-family: var(--kayva-font);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  background: var(--kayva-dark-brown, #3D2A15);
  color: var(--kayva-white, #FFFFFF);
  border: 1px solid var(--kayva-dark-brown, #3D2A15);
  padding: 15px 28px;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s;
  white-space: nowrap;
}
.kv-tapp-{{ section.id }} .kv-tapp__submit:hover { background: var(--kayva-amber, #B8753A); border-color: var(--kayva-amber, #B8753A); }
.kv-tapp-{{ section.id }} .kv-tapp__success { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; padding: 24px 0; }
.kv-tapp-{{ section.id }} .kv-tapp__success-title {
  font-family: var(--kayva-font);
  font-weight: 600;
  font-size: 20px;
  color: var(--kayva-dark-brown, #3D2A15);
  margin: 0;
}
.kv-tapp-{{ section.id }} .kv-tapp__errors {
  grid-column: span 2;
  font-family: var(--kayva-font);
  font-size: 13px;
  color: #A94438;
  margin: 0;
}
@media (max-width: 900px) {
  .kv-tapp-{{ section.id }} { padding: 56px 0; }
  .kv-tapp-{{ section.id }} .kv-tapp__wrap { grid-template-columns: 1fr; gap: 40px; }
  .kv-tapp-{{ section.id }} .kv-tapp__form-box { padding: 24px; }
  .kv-tapp-{{ section.id }} .kv-tapp__form { grid-template-columns: 1fr; }
  .kv-tapp-{{ section.id }} .kv-tapp__field--full, .kv-tapp-{{ section.id }} .kv-tapp__footer { grid-column: span 1; }
}
</style>

<section class="kv-tapp-{{ section.id }}" id="apply">
  <div class="kayva-page-width">
    <div class="kv-tapp__wrap">
      <div class="kv-tapp__copy">
        {%- if section.settings.eyebrow != blank -%}
          <span class="kv-tapp__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="kv-tapp__text">{{ section.settings.text }}</p>
        {%- endif -%}
        <div class="kv-tapp__contact">
          <p class="kv-tapp__contact-label">{{ section.settings.contact_label }}</p>
          {%- if section.settings.whatsapp_display != blank -%}
            <a href="{{ section.settings.whatsapp_link | default: '#' }}">{{ section.settings.whatsapp_display }}</a>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <p class="kv-tapp__hours">{{ section.settings.hours }}</p>
          {%- endif -%}
        </div>
      </div>

      <div class="kv-tapp__form-box">
        {%- form 'contact', class: 'kv-tapp__form', id: 'kv-trade-apply-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="kv-tapp__success kv-tapp__field--full">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#B8753A" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m8 12.5 2.5 2.5L16 9.5"></path></svg>
              <p class="kv-tapp__success-title">{{ section.settings.success_title }}</p>
              <p class="kv-tapp__text">{{ section.settings.success_text }}</p>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <p class="kv-tapp__errors">{{ form.errors | default_errors }}</p>
            {%- endif -%}
            <div class="kv-tapp__field">
              <label for="kv-tapp-name-{{ section.id }}">Full name</label>
              <input type="text" id="kv-tapp-name-{{ section.id }}" name="contact[name]" placeholder="Your name" required>
            </div>
            <div class="kv-tapp__field">
              <label for="kv-tapp-company-{{ section.id }}">Company</label>
              <input type="text" id="kv-tapp-company-{{ section.id }}" name="contact[company]" placeholder="Registered name" required>
            </div>
            <div class="kv-tapp__field">
              <label for="kv-tapp-uen-{{ section.id }}">UEN</label>
              <input type="text" id="kv-tapp-uen-{{ section.id }}" name="contact[uen]" placeholder="e.g. 201812345K" required>
            </div>
            <div class="kv-tapp__field">
              <label for="kv-tapp-role-{{ section.id }}">Your work</label>
              <select id="kv-tapp-role-{{ section.id }}" name="contact[role]">
                <option>Interior designer</option>
                <option>Architect / specifier</option>
                <option>Fit-out contractor</option>
                <option>Electrical installer</option>
                <option>Retailer / reseller</option>
              </select>
            </div>
            <div class="kv-tapp__field">
              <label for="kv-tapp-email-{{ section.id }}">Work email</label>
              <input type="email" id="kv-tapp-email-{{ section.id }}" name="contact[email]" placeholder="you@studio.sg" required>
            </div>
            <div class="kv-tapp__field">
              <label for="kv-tapp-phone-{{ section.id }}">WhatsApp</label>
              <input type="tel" id="kv-tapp-phone-{{ section.id }}" name="contact[phone]" placeholder="+65" required>
            </div>
            <div class="kv-tapp__field kv-tapp__field--full">
              <label for="kv-tapp-vol-{{ section.id }}">Projects per year</label>
              <select id="kv-tapp-vol-{{ section.id }}" name="contact[projects_per_year]">
                <option>1–3</option>
                <option>4–10</option>
                <option>11–25</option>
                <option>25+</option>
              </select>
            </div>
            <div class="kv-tapp__field kv-tapp__field--full">
              <label for="kv-tapp-msg-{{ section.id }}">Current project (optional)</label>
              <textarea id="kv-tapp-msg-{{ section.id }}" name="contact[body]" rows="3" placeholder="Type of space, rough quantities, timeline."></textarea>
            </div>
            <div class="kv-tapp__footer">
              <p class="kv-tapp__privacy">{{ section.settings.privacy_note }}</p>
              <button type="submit" class="kv-tapp__submit">{{ section.settings.submit_label }}</button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KAYVA Trade Apply",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Apply" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Open a trade account." },
    { "type": "textarea", "id": "text", "label": "Intro text", "default": "We reply within one working day with your tier, price list, and sample pack link. No deposit, no annual fee, no minimum first order." },
    { "type": "header", "content": "Contact details" },
    { "type": "text", "id": "contact_label", "label": "Contact label", "default": "Prefer to talk" },
    { "type": "text", "id": "whatsapp_display", "label": "WhatsApp display text", "default": "WhatsApp +65 8123 4567" },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp link" },
    { "type": "text", "id": "email", "label": "Email address", "default": "trade@kayva.sg" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Fri, 9am–6pm SGT." },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Submit application" },
    { "type": "textarea", "id": "privacy_note", "label": "Privacy note", "default": "We use your details to verify the account and send pricing. Nothing else." },
    { "type": "text", "id": "success_title", "label": "Success title", "default": "Application received." },
    { "type": "textarea", "id": "success_text", "label": "Success text", "default": "We'll confirm your tier and send the trade price list within one working day. Check your spam folder if nothing arrives by then." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "KAYVA Trade Apply" }
  ]
}
{% endschema %}
