{{ 'kayva.css' | asset_url | stylesheet_tag }}
<style>
.kv-tben-{{ section.id }} { background: {{ section.settings.bg }}; padding: 80px 0; }
.kv-tben-{{ section.id }} .kv-tben__eyebrow {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-amber, #B8753A);
  display: block;
  margin-bottom: 10px;
}
.kv-tben-{{ section.id }} h2 {
  font-family: var(--kayva-font);
  font-weight: 600;
  font-size: 28px;
  color: var(--kayva-dark-brown, #3D2A15);
  line-height: 1.2;
  margin: 0 0 40px;
}
.kv-tben-{{ section.id }} .kv-tben__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
.kv-tben-{{ section.id }} .kv-tben__card {
  padding: 32px 26px;
  border: 1px solid var(--kayva-line, #E8E0D2);
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.kv-tben-{{ section.id }} .kv-tben__num {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  color: var(--kayva-amber, #B8753A);
  margin: 0;
}
.kv-tben-{{ section.id }} .kv-tben__title {
  font-family: var(--kayva-font);
  font-weight: 600;
  font-size: 16px;
  color: var(--kayva-dark-brown, #3D2A15);
  line-height: 1.3;
  margin: 0;
}
.kv-tben-{{ section.id }} .kv-tben__text {
  font-family: var(--kayva-font);
  font-size: 13px;
  color: var(--kayva-ink, #1F1B16);
  line-height: 1.7;
  opacity: 0.85;
  margin: 0;
}
@media (max-width: 900px) {
  .kv-tben-{{ section.id }} .kv-tben__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .kv-tben-{{ section.id }} { padding: 56px 0; }
  .kv-tben-{{ section.id }} .kv-tben__grid { grid-template-columns: 1fr; }
}
</style>

<section class="kv-tben-{{ section.id }}">
  <div class="kayva-page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="kv-tben__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    <div class="kv-tben__grid">
      {%- for block in section.blocks -%}
        <div class="kv-tben__card" {{ block.shopify_attributes }}>
          <p class="kv-tben__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
          <p class="kv-tben__title">{{ block.settings.title }}</p>
          <p class="kv-tben__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KAYVA Trade Benefits",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What You Get" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four things that make specifying easier." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Tiered trade pricing" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "15–30% off retail depending on annual volume. Published rates — no negotiating, no quote roulette." }
      ]
    }
  ],
  "presets": [
    {
      "name": "KAYVA Trade Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Tiered trade pricing", "text": "15–30% off retail depending on annual volume. Published rates — no negotiating, no quote roulette." } },
        { "type": "benefit", "settings": { "title": "Sample packs at cost", "text": "Every product, both CCTs, in a client-presentable box. S$29 delivered, credited back on your first order." } },
        { "type": "benefit", "settings": { "title": "Batch reservation", "text": "We hold one production batch for your project so the strip in the kitchen matches the strip in the hallway." } },
        { "type": "benefit", "settings": { "title": "Spec sheets on request", "text": "LM-79 reports, driver sizing, and cut-out dimensions issued as PDF for your tender documents." } }
      ]
    }
  ]
}
{% endschema %}
