{{ 'kayva.css' | asset_url | stylesheet_tag }}
<style>
.kv-spill-{{ section.id }} { background: {{ section.settings.bg }}; padding: 96px 0; }
.kv-spill-{{ section.id }} .kv-spill__wrap {
  display: grid;
  grid-template-columns: minmax(220px, 300px) minmax(0, 1fr);
  gap: 64px;
  align-items: start;
}
.kv-spill-{{ section.id }} .kv-spill__eyebrow {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-amber, #B8753A);
  display: block;
  margin-bottom: 16px;
}
.kv-spill-{{ section.id }} h2 {
  font-family: var(--kayva-font);
  font-size: clamp(20px, 2.5vw, 28px);
  font-weight: 600;
  line-height: 1.2;
  color: var(--kayva-dark-brown, #3D2A15);
  margin: 0;
}
.kv-spill-{{ section.id }} .kv-spill__cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 24px;
}
.kv-spill-{{ section.id }} .kv-spill__card {
  border: 1px solid var(--kayva-line, #E8E0D2);
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.kv-spill-{{ section.id }} .kv-spill__num {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  color: var(--kayva-amber, #B8753A);
  margin: 0;
}
.kv-spill-{{ section.id }} .kv-spill__title {
  font-family: var(--kayva-font);
  font-weight: 600;
  font-size: 16px;
  color: var(--kayva-dark-brown, #3D2A15);
  line-height: 1.3;
  margin: 0;
}
.kv-spill-{{ section.id }} .kv-spill__text {
  font-family: var(--kayva-font);
  font-size: 14px;
  color: var(--kayva-ink, #1F1B16);
  line-height: 1.7;
  opacity: 0.85;
  margin: 0;
}
@media (max-width: 900px) {
  .kv-spill-{{ section.id }} { padding: 56px 0; }
  .kv-spill-{{ section.id }} .kv-spill__wrap { grid-template-columns: 1fr; gap: 32px; }
}
</style>

<section class="kv-spill-{{ section.id }}">
  <div class="kayva-page-width">
    <div class="kv-spill__wrap">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="kv-spill__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="kv-spill__cards">
        {%- for block in section.blocks -%}
          <div class="kv-spill__card" {{ block.shopify_attributes }}>
            <p class="kv-spill__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
            <p class="kv-spill__title">{{ block.settings.title }}</p>
            <p class="kv-spill__text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KAYVA Split Pillars",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Local Shipping" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How your order reaches you." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Processing time" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Orders are typically processed within 1–2 working days of payment confirmation." }
      ]
    }
  ],
  "presets": [
    {
      "name": "KAYVA Split Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "title": "Processing time", "text": "Orders are typically processed within 1–2 working days of payment confirmation." } },
        { "type": "pillar", "settings": { "title": "Delivery time", "text": "Once shipped, your order arrives within 1–3 working days via our trusted local courier partners." } },
        { "type": "pillar", "settings": { "title": "Self collection", "text": "Available at our warehouse. Select the option at checkout and we will notify you when your order is ready for pickup." } }
      ]
    }
  ]
}
{% endschema %}
