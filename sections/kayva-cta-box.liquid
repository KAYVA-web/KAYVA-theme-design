{{ 'kayva.css' | asset_url | stylesheet_tag }}
<style>
.kv-ctabox-{{ section.id }} { background: {{ section.settings.bg }}; padding: 96px 0; }
.kv-ctabox-{{ section.id }} .kv-ctabox__box {
  border: 1px solid var(--kayva-line, #E8E0D2);
  padding: 56px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 260px;
  gap: 64px;
  align-items: center;
}
.kv-ctabox-{{ section.id }} .kv-ctabox__eyebrow {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-amber, #B8753A);
  display: block;
  margin-bottom: 16px;
}
.kv-ctabox-{{ section.id }} h2 {
  font-family: var(--kayva-font);
  font-size: clamp(20px, 2.5vw, 28px);
  font-weight: 600;
  line-height: 1.2;
  color: var(--kayva-dark-brown, #3D2A15);
  margin: 0 0 16px;
}
.kv-ctabox-{{ section.id }} .kv-ctabox__text {
  font-family: var(--kayva-font);
  font-size: 15px;
  line-height: 1.75;
  color: var(--kayva-warm-brown, #6B4823);
  margin: 0;
  max-width: 560px;
}
.kv-ctabox-{{ section.id }} .kv-ctabox__actions { display: flex; flex-direction: column; gap: 12px; align-items: stretch; }
.kv-ctabox-{{ section.id }} .kv-ctabox__btn {
  font-family: var(--kayva-font);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  text-align: center;
  text-decoration: none;
  padding: 15px 24px;
  transition: background 0.2s, color 0.2s, border-color 0.2s;
  white-space: nowrap;
}
.kv-ctabox-{{ section.id }} .kv-ctabox__btn--primary {
  background: var(--kayva-dark-brown, #3D2A15);
  color: var(--kayva-white, #FFFFFF);
  border: 1.5px solid var(--kayva-dark-brown, #3D2A15);
}
.kv-ctabox-{{ section.id }} .kv-ctabox__btn--primary:hover {
  background: var(--kayva-amber, #B8753A);
  border-color: var(--kayva-amber, #B8753A);
}
.kv-ctabox-{{ section.id }} .kv-ctabox__btn--outline {
  background: transparent;
  color: var(--kayva-dark-brown, #3D2A15);
  border: 1.5px solid var(--kayva-dark-brown, #3D2A15);
}
.kv-ctabox-{{ section.id }} .kv-ctabox__btn--outline:hover {
  background: var(--kayva-dark-brown, #3D2A15);
  color: var(--kayva-white, #FFFFFF);
}
@media (max-width: 900px) {
  .kv-ctabox-{{ section.id }} { padding: 56px 0; }
  .kv-ctabox-{{ section.id }} .kv-ctabox__box { grid-template-columns: 1fr; gap: 32px; padding: 28px; }
}
</style>

<section class="kv-ctabox-{{ section.id }}">
  <div class="kayva-page-width">
    <div class="kv-ctabox__box">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="kv-ctabox__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="kv-ctabox__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      <div class="kv-ctabox__actions">
        {%- if section.settings.btn1_label != blank -%}
          <a href="{{ section.settings.btn1_link | default: '#' }}" class="kv-ctabox__btn kv-ctabox__btn--primary">{{ section.settings.btn1_label }}</a>
        {%- endif -%}
        {%- if section.settings.btn2_label != blank -%}
          <a href="{{ section.settings.btn2_link | default: '#' }}" class="kv-ctabox__btn kv-ctabox__btn--outline">{{ section.settings.btn2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KAYVA CTA Box",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bulk & Wholesale" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Custom delivery for large and wholesale orders." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "For project quantities and trade supply we arrange delivery around your site schedule. Contact us directly for scheduling and logistics support." },
    { "type": "text", "id": "btn1_label", "label": "Primary button label", "default": "Contact Us" },
    { "type": "url", "id": "btn1_link", "label": "Primary button link" },
    { "type": "text", "id": "btn2_label", "label": "Outline button label", "default": "Trade Program" },
    { "type": "url", "id": "btn2_link", "label": "Outline button link" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "KAYVA CTA Box" }
  ]
}
{% endschema %}
