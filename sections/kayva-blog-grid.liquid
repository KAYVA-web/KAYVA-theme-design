{{ 'kayva.css' | asset_url | stylesheet_tag }}
<style>
.kv-bgrid-{{ section.id }} { background: {{ section.settings.bg }}; padding: 64px 0 80px; }
.kv-bgrid-{{ section.id }} .kv-bgrid__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
  border-bottom: 1px solid var(--kayva-line, #E8E0D2);
  padding-bottom: 20px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}
.kv-bgrid-{{ section.id }} h2 {
  font-family: var(--kayva-font);
  font-weight: 600;
  font-size: 28px;
  color: var(--kayva-dark-brown, #3D2A15);
  line-height: 1.2;
  margin: 0;
}
.kv-bgrid-{{ section.id }} .kv-bgrid__filters { display: flex; gap: 8px; flex-wrap: wrap; }
.kv-bgrid-{{ section.id }} .kv-bgrid__filter {
  font-family: var(--kayva-font);
  padding: 9px 16px;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  white-space: nowrap;
  border: 1.5px solid var(--kayva-line, #E8E0D2);
  color: var(--kayva-dark-brown, #3D2A15);
  text-decoration: none;
  transition: background 0.15s, color 0.15s;
}
.kv-bgrid-{{ section.id }} .kv-bgrid__filter:hover { border-color: var(--kayva-warm-brown, #6B4823); }
.kv-bgrid-{{ section.id }} .kv-bgrid__filter.is-active { background: var(--kayva-dark-brown, #3D2A15); color: var(--kayva-cream, #F5EFE5); border-color: var(--kayva-dark-brown, #3D2A15); }
.kv-bgrid-{{ section.id }} .kv-bgrid__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px 24px;
}
.kv-bgrid-{{ section.id }} .kv-bgrid__card { display: flex; flex-direction: column; gap: 14px; text-decoration: none; }
.kv-bgrid-{{ section.id }} .kv-bgrid__media {
  position: relative;
  height: 210px;
  background: var(--kayva-cream, #F5EFE5);
  overflow: hidden;
}
.kv-bgrid-{{ section.id }} .kv-bgrid__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.kv-bgrid-{{ section.id }} .kv-bgrid__card:hover .kv-bgrid__media img { transform: scale(1.04); }
.kv-bgrid-{{ section.id }} .kv-bgrid__meta {
  font-family: var(--kayva-font);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-amber, #B8753A);
}
.kv-bgrid-{{ section.id }} .kv-bgrid__title {
  font-family: var(--kayva-font);
  font-weight: 600;
  font-size: 17px;
  color: var(--kayva-dark-brown, #3D2A15);
  line-height: 1.35;
  margin: 0;
}
.kv-bgrid-{{ section.id }} .kv-bgrid__excerpt {
  font-family: var(--kayva-font);
  font-size: 14px;
  color: var(--kayva-ink, #1F1B16);
  line-height: 1.7;
  margin: 0;
  opacity: 0.85;
}
.kv-bgrid-{{ section.id }} .kv-bgrid__empty {
  font-family: var(--kayva-font);
  font-size: 15px;
  color: var(--kayva-soft-brown, #8A5524);
  margin: 0;
}
.kv-bgrid-{{ section.id }} .kv-bgrid__pagination {
  display: flex;
  justify-content: center;
  gap: 16px;
  margin-top: 48px;
  font-family: var(--kayva-font);
}
.kv-bgrid-{{ section.id }} .kv-bgrid__pagination a,
.kv-bgrid-{{ section.id }} .kv-bgrid__pagination span {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--kayva-dark-brown, #3D2A15);
  text-decoration: none;
  padding: 8px 12px;
}
.kv-bgrid-{{ section.id }} .kv-bgrid__pagination .current { color: var(--kayva-amber, #B8753A); }
@media (max-width: 900px) {
  .kv-bgrid-{{ section.id }} { padding: 48px 0 56px; }
  .kv-bgrid-{{ section.id }} .kv-bgrid__grid { grid-template-columns: 1fr; }
}
</style>

<section class="kv-bgrid-{{ section.id }}">
  <div class="kayva-page-width">
    {%- paginate blog.articles by section.settings.posts_per_page -%}
      <div class="kv-bgrid__head">
        <h2>
          {%- if current_tags -%}
            {{ current_tags | join: ', ' }}
          {%- else -%}
            {{ section.settings.heading }}
          {%- endif -%}
        </h2>
        {%- if section.settings.show_filters and blog.all_tags.size > 0 -%}
          <div class="kv-bgrid__filters">
            <a href="{{ blog.url }}" class="kv-bgrid__filter{% unless current_tags %} is-active{% endunless %}">All</a>
            {%- for tag in blog.all_tags -%}
              <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="kv-bgrid__filter{% if current_tags contains tag %} is-active{% endif %}">{{ tag }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if blog.articles.size > 0 -%}
        <div class="kv-bgrid__grid">
          {%- for article in blog.articles -%}
            <a href="{{ article.url }}" class="kv-bgrid__card">
              <div class="kv-bgrid__media">
                {%- if article.image -%}
                  <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy">
                {%- endif -%}
              </div>
              <span class="kv-bgrid__meta">
                {%- if article.tags.size > 0 -%}
                  {{ article.tags | join: ' · ' }}
                {%- else -%}
                  {{ article.published_at | date: '%d %b %Y' }}
                {%- endif -%}
              </span>
              <h3 class="kv-bgrid__title">{{ article.title }}</h3>
              <p class="kv-bgrid__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
            </a>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="kv-bgrid__empty">{{ section.settings.empty_text }}</p>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <div class="kv-bgrid__pagination">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "KAYVA Blog Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (no filter active)", "default": "All guides" },
    { "type": "checkbox", "id": "show_filters", "label": "Show tag filters", "default": true },
    { "type": "range", "id": "posts_per_page", "label": "Posts per page", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "text", "id": "empty_text", "label": "Empty state text", "default": "Guides are on the way. Check back soon." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "KAYVA Blog Grid" }
  ]
}
{% endschema %}
