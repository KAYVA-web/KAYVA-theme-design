{{ 'kayva.css' | asset_url | stylesheet_tag }}
<style>
.kv-sdet-{{ section.id }} { background: {{ section.settings.bg }}; padding: 96px 0; }
.kv-sdet-{{ section.id }} .kv-sdet__wrap {
  display: grid;
  grid-template-columns: minmax(220px, 300px) minmax(0, 1fr);
  gap: 64px;
  align-items: start;
}
.kv-sdet-{{ section.id }} .kv-sdet__eyebrow {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-amber, #B8753A);
  display: block;
  margin-bottom: 16px;
}
.kv-sdet-{{ section.id }} h2 {
  font-family: var(--kayva-font);
  font-size: clamp(20px, 2.5vw, 28px);
  font-weight: 600;
  line-height: 1.2;
  color: var(--kayva-dark-brown, #3D2A15);
  margin: 0;
}
.kv-sdet-{{ section.id }} .kv-sdet__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  background: var(--kayva-line, #E8E0D2);
}
.kv-sdet-{{ section.id }} .kv-sdet__cell { background: {{ section.settings.bg }}; padding: 32px; }
.kv-sdet-{{ section.id }} .kv-sdet__label {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-soft-brown, #8A5524);
  margin: 0 0 14px;
}
.kv-sdet-{{ section.id }} .kv-sdet__text {
  font-family: var(--kayva-font);
  font-size: 15px;
  line-height: 1.75;
  color: var(--kayva-ink, #1F1B16);
  margin: 0 0 12px;
}
.kv-sdet-{{ section.id }} .kv-sdet__note {
  font-family: var(--kayva-font);
  font-size: 13px;
  line-height: 1.6;
  color: var(--kayva-soft-brown, #8A5524);
  margin: 0;
}
@media (max-width: 900px) {
  .kv-sdet-{{ section.id }} { padding: 56px 0; }
  .kv-sdet-{{ section.id }} .kv-sdet__wrap { grid-template-columns: 1fr; gap: 32px; }
}
@media (max-width: 700px) {
  .kv-sdet-{{ section.id }} .kv-sdet__grid { grid-template-columns: 1fr; }
}
</style>

<section class="kv-sdet-{{ section.id }}">
  <div class="kayva-page-width">
    <div class="kv-sdet__wrap">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="kv-sdet__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <div class="kv-sdet__grid">
        {%- for block in section.blocks -%}
          <div class="kv-sdet__cell" {{ block.shopify_attributes }}>
            <p class="kv-sdet__label">{{ block.settings.label }}</p>
            <p class="kv-sdet__text">{{ block.settings.text }}</p>
            {%- if block.settings.note != blank -%}
              <p class="kv-sdet__note">{{ block.settings.note }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KAYVA Split Details",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Details" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fees, tracking and coverage." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#F5EFE5" }
  ],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail cell",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shipping Fees" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Standard delivery is charged at a flat rate, and is free for orders above the qualifying spend." },
        { "type": "textarea", "id": "note", "label": "Note", "default": "Fees are shown clearly at checkout. No hidden charges." }
      ]
    }
  ],
  "presets": [
    {
      "name": "KAYVA Split Details",
      "blocks": [
        { "type": "detail", "settings": { "label": "Shipping Fees", "text": "Standard delivery is charged at a flat rate, and is free for orders above the qualifying spend.", "note": "Fees are shown clearly at checkout. No hidden charges." } },
        { "type": "detail", "settings": { "label": "Delivery Areas", "text": "We currently deliver across Singapore only, including HDB, condominium and commercial addresses.", "note": "No international shipping at this time." } },
        { "type": "detail", "settings": { "label": "Order Tracking", "text": "Once your order ships, a tracking link is sent by email so you can follow its journey to your doorstep.", "note": "Check your spam folder if it has not arrived within 48 hours of dispatch." } },
        { "type": "detail", "settings": { "label": "Delivery Issues", "text": "Delays, a wrong item, or a damaged package: contact us within 48 hours of delivery and we will make it right.", "note": "Photographs of the packaging help us resolve claims faster." } }
      ]
    }
  ]
}
{% endschema %}
