{{ 'kayva.css' | asset_url | stylesheet_tag }}
<style>
.kv-cscale-{{ section.id }} { background: {{ section.settings.bg }}; padding: 80px 0; }
.kv-cscale-{{ section.id }} .kv-cscale__wrap {
  display: grid;
  grid-template-columns: 1fr 1.35fr;
  gap: 80px;
  align-items: start;
}
.kv-cscale-{{ section.id }} .kv-cscale__eyebrow {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-amber, #B8753A);
  display: block;
  margin-bottom: 10px;
}
.kv-cscale-{{ section.id }} h2 {
  font-family: var(--kayva-font);
  font-weight: 600;
  font-size: 28px;
  color: var(--kayva-dark-brown, #3D2A15);
  line-height: 1.2;
  margin: 0 0 24px;
}
.kv-cscale-{{ section.id }} .kv-cscale__rows { border-top: 1px solid var(--kayva-line, #E8E0D2); }
.kv-cscale-{{ section.id }} .kv-cscale__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 0;
  border-bottom: 1px solid var(--kayva-line, #E8E0D2);
}
.kv-cscale-{{ section.id }} .kv-cscale__row-label {
  font-family: var(--kayva-font);
  font-size: 14px;
  color: var(--kayva-ink, #1F1B16);
}
.kv-cscale-{{ section.id }} .kv-cscale__row-value {
  font-family: var(--kayva-font);
  font-size: 15px;
  font-weight: 600;
  color: var(--kayva-dark-brown, #3D2A15);
  white-space: nowrap;
}
.kv-cscale-{{ section.id }} .kv-cscale__row-value--accent { color: var(--kayva-amber, #B8753A); }
.kv-cscale-{{ section.id }} .kv-cscale__row-value--muted { color: var(--kayva-soft-brown, #8A5524); }
.kv-cscale-{{ section.id }} .kv-cscale__copy { display: flex; flex-direction: column; gap: 22px; padding-top: 6px; }
.kv-cscale-{{ section.id }} .kv-cscale__text {
  font-family: var(--kayva-font);
  font-size: 15px;
  color: var(--kayva-ink, #1F1B16);
  line-height: 1.75;
  margin: 0;
}
.kv-cscale-{{ section.id }} .kv-cscale__highlight {
  font-family: var(--kayva-font);
  font-size: 15px;
  font-weight: 500;
  color: var(--kayva-dark-brown, #3D2A15);
  line-height: 1.75;
  margin: 0;
  padding: 18px 0 0;
  border-top: 1px solid var(--kayva-line, #E8E0D2);
}
@media (max-width: 900px) {
  .kv-cscale-{{ section.id }} { padding: 56px 0; }
  .kv-cscale-{{ section.id }} .kv-cscale__wrap { grid-template-columns: 1fr; gap: 36px; }
}
</style>

<section class="kv-cscale-{{ section.id }}">
  <div class="kayva-page-width">
    <div class="kv-cscale__wrap">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="kv-cscale__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="kv-cscale__rows">
          {%- for block in section.blocks -%}
            <div class="kv-cscale__row" {{ block.shopify_attributes }}>
              <span class="kv-cscale__row-label">{{ block.settings.label }}</span>
              <span class="kv-cscale__row-value kv-cscale__row-value--{{ block.settings.style }}">{{ block.settings.value }}</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
      <div class="kv-cscale__copy">
        {%- if section.settings.text1 != blank -%}
          <p class="kv-cscale__text">{{ section.settings.text1 }}</p>
        {%- endif -%}
        {%- if section.settings.text2 != blank -%}
          <p class="kv-cscale__text">{{ section.settings.text2 }}</p>
        {%- endif -%}
        {%- if section.settings.highlight != blank -%}
          <p class="kv-cscale__highlight">{{ section.settings.highlight }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KAYVA CRI Scale",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Spec" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A scale to 100. Most LEDs stop at 80." },
    { "type": "textarea", "id": "text1", "label": "Paragraph 1", "default": "CRI — Colour Rendering Index — measures how faithfully a light source shows colour compared with natural light, on a scale to 100. Sunlight scores 100. A candle scores close to 100. Most LED lighting sold in Singapore scores around 80." },
    { "type": "textarea", "id": "text2", "label": "Paragraph 2", "default": "At Ra80, roughly a fifth of colour fidelity is gone — and it is not lost evenly. Reds fade first. Wood turns grey-brown, leather goes flat, skin looks tired, food looks less fresh. The room is bright, but everything in it is slightly wrong." },
    { "type": "text", "id": "highlight", "label": "Closing line", "default": "Nothing in the room changed. Only the light did." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Scale row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Sunlight" },
        { "type": "text", "id": "value", "label": "Value", "default": "Ra100" },
        {
          "type": "select",
          "id": "style",
          "label": "Value style",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "accent", "label": "Amber accent" },
            { "value": "muted", "label": "Muted" }
          ],
          "default": "default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KAYVA CRI Scale",
      "blocks": [
        { "type": "row", "settings": { "label": "Sunlight", "value": "Ra100", "style": "default" } },
        { "type": "row", "settings": { "label": "Candle flame", "value": "Ra99", "style": "default" } },
        { "type": "row", "settings": { "label": "Every KAYVA product", "value": "Ra95+", "style": "accent" } },
        { "type": "row", "settings": { "label": "Typical LED sold in Singapore", "value": "Ra80", "style": "muted" } }
      ]
    }
  ]
}
{% endschema %}
