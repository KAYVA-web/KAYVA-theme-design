{{ 'kayva.css' | asset_url | stylesheet_tag }}
<style>
.kv-astory-{{ section.id }} { background: {{ section.settings.bg }}; padding: 80px 0; }
.kv-astory-{{ section.id }} .kv-astory__wrap {
  display: grid;
  grid-template-columns: 1fr 1.35fr;
  gap: 80px;
  align-items: start;
}
.kv-astory-{{ section.id }} .kv-astory__eyebrow {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-amber, #B8753A);
  display: block;
  margin-bottom: 10px;
}
.kv-astory-{{ section.id }} h2 {
  font-family: var(--kayva-font);
  font-weight: 600;
  font-size: 28px;
  color: var(--kayva-dark-brown, #3D2A15);
  line-height: 1.2;
  margin: 0 0 24px;
}
.kv-astory-{{ section.id }} .kv-astory__card { border: 1px solid var(--kayva-line, #E8E0D2); padding: 28px; }
.kv-astory-{{ section.id }} .kv-astory__card-label {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-soft-brown, #8A5524);
  margin: 0 0 12px;
}
.kv-astory-{{ section.id }} .kv-astory__card-text {
  font-family: var(--kayva-font);
  font-size: 15px;
  color: var(--kayva-ink, #1F1B16);
  line-height: 1.75;
  margin: 0;
}
.kv-astory-{{ section.id }} .kv-astory__copy { display: flex; flex-direction: column; gap: 22px; padding-top: 6px; }
.kv-astory-{{ section.id }} .kv-astory__text {
  font-family: var(--kayva-font);
  font-size: 15px;
  color: var(--kayva-ink, #1F1B16);
  line-height: 1.75;
  margin: 0;
}
.kv-astory-{{ section.id }} .kv-astory__quote {
  font-family: var(--kayva-font);
  font-size: 20px;
  font-weight: 400;
  color: var(--kayva-dark-brown, #3D2A15);
  line-height: 1.5;
  margin: 0;
  border-top: 1px solid var(--kayva-line, #E8E0D2);
  padding-top: 22px;
}
@media (max-width: 900px) {
  .kv-astory-{{ section.id }} { padding: 56px 0; }
  .kv-astory-{{ section.id }} .kv-astory__wrap { grid-template-columns: 1fr; gap: 36px; }
}
</style>

<section class="kv-astory-{{ section.id }}">
  <div class="kayva-page-width">
    <div class="kv-astory__wrap">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="kv-astory__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.card_text != blank -%}
          <div class="kv-astory__card">
            {%- if section.settings.card_label != blank -%}
              <p class="kv-astory__card-label">{{ section.settings.card_label }}</p>
            {%- endif -%}
            <p class="kv-astory__card-text">{{ section.settings.card_text }}</p>
          </div>
        {%- endif -%}
      </div>
      <div class="kv-astory__copy">
        {%- for block in section.blocks -%}
          <p class="kv-astory__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- endfor -%}
        {%- if section.settings.quote != blank -%}
          <p class="kv-astory__quote">{{ section.settings.quote }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KAYVA About Story",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How It Started" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Labelled CRI 90. Measured CRI 80." },
    { "type": "text", "id": "card_label", "label": "Card label", "default": "What we found" },
    { "type": "textarea", "id": "card_text", "label": "Card text", "default": "Bulb after bulb, strip after strip, the pattern repeated: \"high CRI\" on the listing, Ra80-something on the meter. In a market where nobody checks, nobody has to tell the truth." },
    { "type": "textarea", "id": "quote", "label": "Pull quote", "default": "KAYVA exists because we could not buy the light we wanted. So we built it." },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "We had just finished renovating our home." }
      ]
    }
  ],
  "presets": [
    {
      "name": "KAYVA About Story",
      "blocks": [
        { "type": "paragraph", "settings": { "text": "We had just finished renovating our home. Warm oak floors, a leather sofa we had saved for, paint colours chosen over three weekends. Under the downlights, all of it looked flat. The oak went grey. The leather lost its depth." } },
        { "type": "paragraph", "settings": { "text": "The bulbs were the problem. They were labelled CRI 90. We tested them — CRI 80." } },
        { "type": "paragraph", "settings": { "text": "So we went looking for the real thing." } }
      ]
    }
  ]
}
{% endschema %}
