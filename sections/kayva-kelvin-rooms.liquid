{{ 'kayva.css' | asset_url | stylesheet_tag }}
<style>
.kv-krooms-{{ section.id }} { background: {{ section.settings.bg }}; padding: 80px 0; scroll-margin-top: 16px; }
.kv-krooms-{{ section.id }} .kv-krooms__eyebrow {
  font-family: var(--kayva-font);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-amber, #B8753A);
  display: block;
  margin-bottom: 10px;
}
.kv-krooms-{{ section.id }} h2 {
  font-family: var(--kayva-font);
  font-weight: 600;
  font-size: 28px;
  color: var(--kayva-dark-brown, #3D2A15);
  line-height: 1.2;
  margin: 0 0 40px;
}
.kv-krooms-{{ section.id }} .kv-krooms__table {
  display: grid;
  grid-template-columns: 1fr 140px 2fr;
  border-top: 1px solid var(--kayva-line, #E8E0D2);
}
.kv-krooms-{{ section.id }} .kv-krooms__cell { border-bottom: 1px solid var(--kayva-line, #E8E0D2); font-family: var(--kayva-font); }
.kv-krooms-{{ section.id }} .kv-krooms__head {
  padding: 14px 0;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--kayva-soft-brown, #8A5524);
}
.kv-krooms-{{ section.id }} .kv-krooms__room {
  padding: 18px 16px 18px 0;
  font-size: 15px;
  font-weight: 500;
  color: var(--kayva-dark-brown, #3D2A15);
}
.kv-krooms-{{ section.id }} .kv-krooms__choose {
  padding: 18px 16px 18px 0;
  font-size: 15px;
  font-weight: 600;
  color: var(--kayva-dark-brown, #3D2A15);
}
.kv-krooms-{{ section.id }} .kv-krooms__choose--accent { color: var(--kayva-amber, #B8753A); }
.kv-krooms-{{ section.id }} .kv-krooms__why {
  padding: 18px 0;
  font-size: 14px;
  color: var(--kayva-ink, #1F1B16);
  line-height: 1.7;
}
@media (max-width: 700px) {
  .kv-krooms-{{ section.id }} { padding: 56px 0; }
  .kv-krooms-{{ section.id }} .kv-krooms__table { grid-template-columns: 1fr 90px; }
  .kv-krooms-{{ section.id }} .kv-krooms__why { grid-column: span 2; padding-top: 0; border-bottom: 1px solid var(--kayva-line, #E8E0D2); }
  .kv-krooms-{{ section.id }} .kv-krooms__room, .kv-krooms-{{ section.id }} .kv-krooms__choose { border-bottom: none; }
  .kv-krooms-{{ section.id }} .kv-krooms__head--why { display: none; }
}
</style>

<section class="kv-krooms-{{ section.id }}"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
  <div class="kayva-page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="kv-krooms__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    <div class="kv-krooms__table">
      <div class="kv-krooms__cell kv-krooms__head">{{ section.settings.col1 }}</div>
      <div class="kv-krooms__cell kv-krooms__head">{{ section.settings.col2 }}</div>
      <div class="kv-krooms__cell kv-krooms__head kv-krooms__head--why">{{ section.settings.col3 }}</div>
      {%- for block in section.blocks -%}
        <div class="kv-krooms__cell kv-krooms__room" {{ block.shopify_attributes }}>{{ block.settings.room }}</div>
        <div class="kv-krooms__cell kv-krooms__choose{% if block.settings.accent %} kv-krooms__choose--accent{% endif %}">{{ block.settings.choose }}</div>
        <div class="kv-krooms__cell kv-krooms__why">{{ block.settings.why }}</div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KAYVA Kelvin Rooms",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Room By Room" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where each temperature belongs." },
    { "type": "text", "id": "col1", "label": "Column 1 header", "default": "Room" },
    { "type": "text", "id": "col2", "label": "Column 2 header", "default": "Choose" },
    { "type": "text", "id": "col3", "label": "Column 3 header", "default": "Why" },
    { "type": "text", "id": "anchor", "label": "Anchor ID (optional)", "info": "e.g. rooms" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Room row",
      "settings": [
        { "type": "text", "id": "room", "label": "Room", "default": "Living room" },
        { "type": "text", "id": "choose", "label": "Temperature", "default": "2700K" },
        { "type": "checkbox", "id": "accent", "label": "Amber temperature", "default": false },
        { "type": "textarea", "id": "why", "label": "Why", "default": "Warmth suits wood, fabric and evening wind-down." }
      ]
    }
  ],
  "presets": [
    {
      "name": "KAYVA Kelvin Rooms",
      "blocks": [
        { "type": "row", "settings": { "room": "Living room", "choose": "2700K", "accent": true, "why": "Warmth suits wood, fabric and evening wind-down." } },
        { "type": "row", "settings": { "room": "Bedroom", "choose": "2700K", "accent": true, "why": "Warmer light supports relaxation before sleep." } },
        { "type": "row", "settings": { "room": "Dining", "choose": "2700K", "accent": true, "why": "Food and faces look best under warm light." } },
        { "type": "row", "settings": { "room": "Kitchen", "choose": "4000K", "accent": false, "why": "Neutral white for prep work and judging food colour." } },
        { "type": "row", "settings": { "room": "Study / home office", "choose": "4000K", "accent": false, "why": "Crisp light aids focus and reading." } },
        { "type": "row", "settings": { "room": "Bathroom (grooming)", "choose": "4000K", "accent": false, "why": "Neutral light for accurate skin tones at the mirror." } },
        { "type": "row", "settings": { "room": "Wardrobe / dressing", "choose": "4000K", "accent": false, "why": "Neutral light shows fabric colours as they will appear outdoors." } }
      ]
    }
  ]
}
{% endschema %}
