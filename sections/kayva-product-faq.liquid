{{ 'kayva.css' | asset_url | stylesheet_tag }}
<style>
.kv-faq-{{ section.id }} { padding: 64px 0; background: {{ section.settings.background_color }}; }
.kv-faq-{{ section.id }} .kv-faq__heading {
  font-family: var(--kayva-font);
  font-size: 22px;
  font-weight: 600;
  color: {{ section.settings.heading_color }};
  margin-bottom: 32px;
}
.kv-faq-{{ section.id }} .kv-faq__list { border-top: 1px solid {{ section.settings.divider_color }}; }
.kv-faq-{{ section.id }} .kv-faq__item { border-bottom: 1px solid {{ section.settings.divider_color }}; }
.kv-faq-{{ section.id }} .kv-faq__item summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 18px 0;
  font-family: var(--kayva-font);
  font-size: 15px;
  font-weight: 500;
  color: {{ section.settings.question_color }};
  cursor: pointer;
  list-style: none;
  user-select: none;
}
.kv-faq-{{ section.id }} .kv-faq__item summary::-webkit-details-marker { display: none; }
.kv-faq-{{ section.id }} .kv-faq__item summary svg {
  flex-shrink: 0;
  transition: transform 0.25s;
  color: {{ section.settings.question_color }};
}
.kv-faq-{{ section.id }} .kv-faq__item[open] summary svg { transform: rotate(180deg); }
.kv-faq-{{ section.id }} .kv-faq__answer {
  font-family: var(--kayva-font);
  font-size: 14px;
  color: {{ section.settings.answer_color }};
  line-height: 1.7;
  padding-bottom: 18px;
}
.kv-faq-{{ section.id }} .kv-faq__answer a { color: {{ section.settings.answer_color }}; text-decoration: underline; }
</style>

<section class="kv-faq-{{ section.id }}" id="kv-faq-{{ section.id }}">
  <div class="kayva-page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="kv-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="kv-faq__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'qa' -%}
            <details class="kv-faq__item" {{ block.shopify_attributes }}>
              <summary>
                {{ block.settings.question }}
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="kv-faq__answer">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "KAYVA Product FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#3D2A15"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "Question colour",
      "default": "#3D2A15"
    },
    {
      "type": "color",
      "id": "answer_color",
      "label": "Answer colour",
      "default": "#6B4823"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider colour",
      "default": "#E8E0D2"
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Q&A Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Enter your question here"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Enter your answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KAYVA Product FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "What is included in the box?", "answer": "<p>Enter your answer here.</p>" } },
        { "type": "qa", "settings": { "question": "Is this product dimmable?", "answer": "<p>Enter your answer here.</p>" } }
      ]
    }
  ]
}
{% endschema %}
