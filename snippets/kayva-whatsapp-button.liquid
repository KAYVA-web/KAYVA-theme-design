{% doc %}
  Floating WhatsApp button, bottom right.
  Configured under Theme settings > KAYVA WhatsApp button.
{% enddoc %}

{%- if settings.whatsapp_enabled and settings.whatsapp_number != blank -%}
  {%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
  <a
    href="https://wa.me/{{ wa_number }}{% if settings.whatsapp_message != blank %}?text={{ settings.whatsapp_message | url_encode }}{% endif %}"
    class="kv-whatsapp-btn"
    target="_blank"
    rel="noopener"
    aria-label="Chat with us on WhatsApp"
  >
    <svg viewBox="0 0 32 32" width="30" height="30" fill="currentColor" aria-hidden="true">
      <path d="M16.004 3C8.832 3 3 8.83 3 16c0 2.29.6 4.53 1.74 6.5L3 29l6.66-1.72A13 13 0 0 0 16.004 29C23.17 29 29 23.17 29 16S23.17 3 16.004 3zm0 23.6a10.6 10.6 0 0 1-5.4-1.48l-.39-.23-3.95 1.02 1.05-3.85-.25-.4A10.55 10.55 0 0 1 5.4 16c0-5.84 4.76-10.6 10.6-10.6 5.84 0 10.6 4.76 10.6 10.6s-4.76 10.6-10.6 10.6zm5.82-7.93c-.32-.16-1.89-.93-2.18-1.04-.29-.1-.5-.16-.72.16-.21.32-.82 1.04-1 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.58-.95-.85-1.59-1.9-1.78-2.22-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55h-.61c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66s1.14 3.08 1.3 3.3c.16.21 2.25 3.44 5.45 4.82.76.33 1.36.53 1.82.67.77.25 1.46.21 2.01.13.61-.09 1.89-.77 2.16-1.52.27-.75.27-1.38.19-1.52-.08-.13-.29-.21-.61-.37z"/>
    </svg>
  </a>

  <style>
    .kv-whatsapp-btn {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 90;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #25D366;
      color: #FFFFFF;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .kv-whatsapp-btn:hover {
      transform: scale(1.07);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.28);
      color: #FFFFFF;
    }
    /* Sit above the floating buy bar on product pages */
    body:has(.kv-pinfo__floatbar) .kv-whatsapp-btn {
      bottom: 96px;
    }
    @media (max-width: 600px) {
      .kv-whatsapp-btn {
        width: 50px;
        height: 50px;
        bottom: 18px;
        right: 18px;
      }
      body:has(.kv-pinfo__floatbar) .kv-whatsapp-btn {
        bottom: 110px;
      }
    }
  </style>
{%- endif -%}
