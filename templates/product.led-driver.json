    "kayva_product_faq": {
      "type": "kayva-product-faq",
      "blocks": {
        "qa_ADU8wG": {
          "type": "qa",
          "settings": {
            "question": "How does the two-colour switching work?",
            "answer": "<p>Switch on for 2700K warm white. Flip the wall switch off and on again within a couple of seconds and it changes to 4000K neutral. No app, no hub, no WiFi — the colour is controlled by the light switch you already have.</p>"
          }
        },
        "qa_xN37ci": {
          "type": "qa",
          "settings": {
            "question": "Is it dimmable?",
            "answer": "<p>No. The Switch is non-dimmable by design — the switching mechanism and dimming do not coexist cleanly. If you want dimming, choose the GU10 Dim instead; if you want two colour temperatures without an app, the Switch is the one.</p>"
          }
        },
        "qa_y8wpPK": {
          "type": "qa",
          "settings": {
            "question": "Why choose this over a smart bulb?",
            "answer": "<p>It gives you two useful colour temperatures — warm for evenings, neutral for tasks — with nothing to set up, no app to be discontinued, and nothing to fail when the WiFi is down. It works the day you install it and in ten years' time.</p>"
          }
        },
        "qa_A3NE8B": {
          "type": "qa",
          "settings": {
            "question": "What wattage and fitting is it?",
            "answer": "<p>7W, standard GU10 base, mains voltage. A direct replacement for any GU10 halogen or LED, in downlights or track heads. No transformer required.</p>"
          }
        },
        "qa_1": {
          "type": "qa",
          "settings": {
            "question": "Is the colour quality the same in both temperatures?",
            "answer": "<p>Yes. Both 2700K and 4000K are Ra95+ with R9&gt;50 — the same colour accuracy, tested per batch. Only the warmth of the white changes when you switch.</p>"
          }
        }
      },
