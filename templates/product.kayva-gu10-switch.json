          "settings": {
            "title": "PRODUCT SPECIFICATIONS",
            "content": "<p><strong>Fitting:</strong> GU10<br/><strong>CRI:</strong> Ra95+<br/><strong>R9: </strong>&gt;80<strong><br/>SDCM: </strong>4.2<br/><strong>Lumens:</strong> 490 lm<br/><strong>Power:</strong> 7W<br/><strong>Voltage:</strong> 220–240V AC · 50Hz <br/><strong>Kelvin temperature:</strong> 2700K + 4000K<br/><strong>Dimmable:</strong> No<br/><strong>Beam angle:</strong> 36°<br/><strong>Lifespan:</strong> 25,000 hours<br/><strong>IP rating:</strong> IP20 (indoor use)<br/><strong>Body:</strong> Glass</p>"
