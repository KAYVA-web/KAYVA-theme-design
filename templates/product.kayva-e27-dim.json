            "text": "Driver Sizing"
          }
        },
        "text_VrjB4T": {
          "type": "text",
          "settings": {
            "content": "<p>Multiply your strip length by 12W per metre, then add 20% headroom so the driver isn't running at full capacity. A driver running flat-out runs hot and fails early.</p>"
          }
        },
        "calculator_YCLGi6": {
          "type": "calculator",
          "settings": {
